# Django
DJANGO_SECRET_KEY=generate-a-secure-key-here
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com

# Database
# Postgres (Docker / AWS path):
DATABASE_URL=postgres://user:password@db_host:5432/db_name
# PythonAnywhere free tier (MySQL) instead, e.g.:
# DATABASE_URL=mysql://yourusername:yourpassword@yourusername.mysql.pythonanywhere-services.com/yourusername$yarra

# Redis
REDIS_URL=redis://redis_host:6379/1

# AWS (For S3 Media Storage)
USE_S3=True
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_STORAGE_BUCKET_NAME=your-bucket-name
AWS_S3_REGION_NAME=your-region

# Razorpay
RAZORPAY_KEY_ID=your-key-id
RAZORPAY_SECRET=your-secret
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret

# Sentry
SENTRY_DSN=your-sentry-dsn
